# Server (server/.env)
PORT=5001
# Matches Task2/docker-compose.yml's dedicated task2-postgres service —
# host port 5433 (not 5432) so this never collides with another local
# PostgreSQL install. Replace the password with your own local value.
DATABASE_URL="postgresql://connectly:replace-with-a-local-password@localhost:5433/connectly?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Client (client/.env)
VITE_API_URL=http://localhost:5001/api
