# Test environment — used only by `npm test` (see vitest.config.js / tests/setup.js).
# Copy to server/.env.test and adjust if your local Postgres credentials differ.
#
# Points at a SEPARATE database (taskflow_test) inside the same task3-postgres
# container the dev database (taskflow) already uses — never the dev database
# itself. The test suite truncates every table between test files, so running
# it against the dev database would destroy real local development data.
NODE_ENV=test
DATABASE_URL="postgresql://taskflow:taskflow_dev_password@localhost:5434/taskflow_test?schema=public"
JWT_SECRET=test-only-jwt-secret-never-used-outside-automated-tests
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
