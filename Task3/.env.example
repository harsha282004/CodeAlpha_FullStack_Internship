# Server (server/.env)
NODE_ENV=development
PORT=5002
# Matches Task3/docker-compose.yml's dedicated task3-postgres service —
# host port 5434 (Task1 and Task2 use 5432/5433) so this never collides with
# another local PostgreSQL install. Replace the password with your own local value.
DATABASE_URL="postgresql://taskflow:replace-with-a-local-password@localhost:5434/taskflow?schema=public"
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Client (client/.env)
VITE_API_URL=http://localhost:5002/api
