# Server (server/.env)
PORT=5000
# Postgres user needs standard read/write privileges on this database.
# CREATEDB is also required if you plan to run `prisma migrate dev` (used for its shadow database).
DATABASE_URL="postgresql://user:password@localhost:5432/shopsphere?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Client (client/.env)
VITE_API_URL=http://localhost:5000/api
